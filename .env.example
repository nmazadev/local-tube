# Copy to .env and adjust.

# Required: host folder for downloaded videos (create it first so it's owned by you).
LIBRARY_DIR=./library

# Host port for the web UI: http://127.0.0.1:8080
PORT=8080

# Who can open it: 127.0.0.1 is only this machine. Set 0.0.0.0 to use it from your phone or TV
# (http://<this machine's LAN IP>:8080). Anyone on your network can then use it, and your YouTube account.
BIND=127.0.0.1

# Run as your user so downloads on the host belong to you (`id -u` / `id -g`).
UID=1000
GID=1000
